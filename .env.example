# Environment variables template. Copy to .env and fill in the real values:
#   cp .env.example .env
# .env is gitignored and must never be committed.

# --- SODA API (datos.gov.co) ---
# App Token from your datos.gov.co profile (developer settings). The secret is not needed.
SOCRATA_DOMAIN=www.datos.gov.co
SOCRATA_DATASET_ID=jbjy-vk9h
SOCRATA_APP_TOKEN=

# --- PostgreSQL ---
# Standard libpq names: read by the Python scripts and also directly by psql.
PGHOST=localhost
PGPORT=5432
PGDATABASE=secop
PGUSER=secop_app
PGPASSWORD=
